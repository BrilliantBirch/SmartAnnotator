/*
 * VAI_E SmartAnnotator 现代化样式表
 * Author: Baibinnan
 * Date: 2026/06/24
 * 设计语言: 简洁现代，蓝白配色，圆角轻阴影
 */

/* ==================== 全局 ==================== */
QMainWindow {
    background-color: #f0f2f5;
}

QWidget#centralwidget {
    background-color: #f0f2f5;
}

/* ==================== QStackedWidget 页面 ==================== */
QStackedWidget {
    background-color: transparent;
}

/* ==================== 欢迎页 ==================== */
QWidget#welcomePage {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
            stop:0 #1a73e8, stop:0.5 #4a90d9, stop:1 #6db3f2);
    border-radius: 12px;
}

QWidget#welcomePage QLabel#welcomeLabel {
    color: #ffffff;
    font-size: 28px;
    font-weight: bold;
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
}

QWidget#welcomePage QLabel#welcomeLabel2 {
    color: rgba(255, 255, 255, 0.8);
    font-size: 14px;
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
}

/* ==================== 菜单栏 ==================== */
QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e0e0e0;
    padding: 4px 0;
    font-size: 14px;
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
}

QMenuBar::item {
    padding: 8px 18px;
    border-radius: 6px;
    margin: 2px 4px;
}

QMenuBar::item:selected {
    background-color: #e8f0fe;
    color: #1a73e8;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 4px;
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
}

QMenu::item {
    padding: 8px 32px 8px 16px;
    border-radius: 6px;
    margin: 2px;
}

QMenu::item:selected {
    background-color: #e8f0fe;
    color: #1a73e8;
}

/* ==================== 标签页容器 ==================== */
QWidget#convertPage,
QWidget#annotatePage {
    background-color: #ffffff;
    border-radius: 12px;
    padding: 16px;
}

/* ==================== 标签 ==================== */
QLabel {
    color: #333333;
    font-size: 14px;
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
}

/* 提示信息标签 */
QLabel#label_3 {
    color: #e67e22;
    background-color: #fef9e7;
    border: 1px solid #f9e79f;
    border-radius: 6px;
    padding: 8px 14px;
    font-size: 13px;
}

/* 区域标题 */
QLabel#labelListLabel,
QLabel#kptLabel,
QLabel#annotationFilesLabel,
QLabel#label_28,
QLabel#label_34 {
    font-size: 15px;
    font-weight: bold;
    color: #1a1a1a;
    padding: 6px 0;
}

/* ==================== 按钮 ==================== */
QPushButton {
    background-color: #1a73e8;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 14px;
    font-weight: 500;
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #1557b0;
}

QPushButton:pressed {
    background-color: #114a9e;
}

QPushButton:disabled {
    background-color: #c0c0c0;
    color: #888888;
}

/* 浏览按钮（次要操作） */
QPushButton#convertInputBtn,
QPushButton#convertOutputBtn,
QPushButton#modelInputBtn,
QPushButton#annotateImgInputBtn,
QPushButton#annotateOutputBtn {
    background-color: #ffffff;
    color: #1a73e8;
    border: 1px solid #1a73e8;
    border-radius: 6px;
    padding: 7px 16px;
    font-size: 14px;
}

QPushButton#convertInputBtn:hover,
QPushButton#convertOutputBtn:hover,
QPushButton#modelInputBtn:hover,
QPushButton#annotateImgInputBtn:hover,
QPushButton#annotateOutputBtn:hover {
    background-color: #e8f0fe;
}

/* 添加/清空按钮 */
QPushButton#addLabelBtn,
QPushButton#clearLabelBtn,
QPushButton#addKptBtn,
QPushButton#clearKptBtn {
    background-color: #f5f5f5;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 5px 14px;
    font-size: 13px;
}

QPushButton#addLabelBtn:hover,
QPushButton#clearLabelBtn:hover,
QPushButton#addKptBtn:hover,
QPushButton#clearKptBtn:hover {
    background-color: #e8e8e8;
    border-color: #b0b0b0;
}

/* 开始/停止按钮 */
QPushButton#convertRunBtn,
QPushButton#annotateBtn {
    background-color: #0d904f;
    color: #ffffff;
    padding: 10px 28px;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#convertRunBtn:hover,
QPushButton#annotateBtn:hover {
    background-color: #0a7a42;
}

QPushButton#convertCancelBtn,
QPushButton#annotateCancelBtn {
    background-color: #e74c3c;
    color: #ffffff;
    padding: 10px 28px;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#convertCancelBtn:hover,
QPushButton#annotateCancelBtn:hover {
    background-color: #c0392b;
}

/* ==================== 输入框 ==================== */
QLineEdit {
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 7px 12px;
    font-size: 14px;
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    background-color: #ffffff;
    color: #333333;
    min-height: 24px;
}

QLineEdit:focus {
    border-color: #1a73e8;
    background-color: #fafbff;
}

QLineEdit:read-only {
    background-color: #f5f5f5;
    color: #666666;
}

/* 比例输入框 */
QLineEdit#trainRatio,
QLineEdit#valRatio,
QLineEdit#testRatio,
QLineEdit#bboxConfEdit,
QLineEdit#nmsEdit,
QLineEdit#keyConfEdit {
    background-color: #fafafa;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    padding: 5px 10px;
    font-size: 14px;
}

QLineEdit#trainRatio:focus,
QLineEdit#valRatio:focus,
QLineEdit#testRatio:focus,
QLineEdit#bboxConfEdit:focus,
QLineEdit#nmsEdit:focus,
QLineEdit#keyConfEdit:focus {
    border-color: #1a73e8;
    background-color: #ffffff;
}

/* ==================== 下拉框 ==================== */
QComboBox {
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 7px 12px;
    font-size: 14px;
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    background-color: #ffffff;
    color: #333333;
    min-height: 24px;
}

QComboBox:hover {
    border-color: #1a73e8;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #666666;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #e8f0fe;
    selection-color: #1a73e8;
    outline: none;
}

/* ==================== 单选按钮 ==================== */
QRadioButton {
    font-size: 14px;
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    color: #333333;
    spacing: 8px;
    padding: 5px 10px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #b0b0b0;
    border-radius: 10px;
    background-color: #ffffff;
}

QRadioButton::indicator:checked {
    border-color: #1a73e8;
    background-color: #1a73e8;
}

QRadioButton::indicator:hover {
    border-color: #1a73e8;
}

/* ==================== 复选框 ==================== */
QCheckBox {
    font-size: 14px;
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    color: #333333;
    spacing: 8px;
    padding: 5px 10px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #b0b0b0;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    border-color: #1a73e8;
    background-color: #1a73e8;
}

QCheckBox::indicator:hover {
    border-color: #1a73e8;
}

/* ==================== 列表视图 ==================== */
QListView,
QListWidget {
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    background-color: #ffffff;
    font-size: 14px;
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    outline: none;
    padding: 4px;
}

QListView::item,
QListWidget::item {
    padding: 7px 12px;
    border-radius: 4px;
    margin: 1px 4px;
}

QListView::item:selected,
QListWidget::item:selected {
    background-color: #e8f0fe;
    color: #1a73e8;
}

QListView::item:hover,
QListWidget::item:hover {
    background-color: #f5f7fa;
}

/* 交替行颜色 */
QListView::item:alternate,
QListWidget::item:alternate {
    background-color: #fafbfc;
}

/* ==================== 进度条 ==================== */
QProgressBar {
    border: none;
    border-radius: 8px;
    background-color: #e8e8e8;
    text-align: center;
    font-size: 13px;
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    color: #333333;
    min-height: 20px;
    max-height: 20px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
            stop:0 #1a73e8, stop:1 #4a90d9);
    border-radius: 8px;
}

/* ==================== 状态标签 ==================== */
QLabel#convertStatusLabel,
QLabel#annotateStatusLabel {
    color: #666666;
    font-size: 13px;
    padding: 4px 10px;
}

/* ==================== 数量标签 ==================== */
QLabel#annotationFilesNumLabel,
QLabel#annotationImgNumLabel {
    color: #999999;
    font-size: 12px;
    padding: 4px 10px;
}

/* ==================== 页面标题 ==================== */
QLabel#pageTitleLabel {
    background-color: #1a73e8;
    color: #ffffff;
    font-size: 18px;
    font-weight: bold;
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    border-radius: 6px;
    padding: 6px 0;
}

/* ==================== 文本浏览器（日志） ==================== */
QTextBrowser#logBrowser {
    background-color: #fafbfc;
    color: #333333;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    font-size: 13px;
    font-family: "Consolas", "Courier New", "Microsoft YaHei", monospace;
    padding: 10px;
    selection-background-color: #e8f0fe;
    selection-color: #333333;
}

/* ==================== 滚动条 ==================== */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #c0c0c0;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #a0a0a0;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ==================== 分割线 ==================== */
QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #e0e0e0;
}

/* ==================== 工具提示 ==================== */
QToolTip {
    background-color: #333333;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
}