# VAI_E_SmartAnnotator .gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
*.egg-info/
*.egg
MANIFEST

# PyInstaller 构建产物（保留 build/build.py 与 build/app.ico）
build/dist/
build/build_temp/
build/version_info.txt
build/version_counter.txt
build/*.spec
dist/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports（单元测试目录不纳入版本控制）
tests/
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
coverage.xml
*.cover
.hypothesis/

# Translations
*.mo
*.pot

# Logs
*.log
Log/
Logs/
output/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Editor / IDE
.vscode/
.trae/
.idea/
*.swp
*~

# Model files（体积大，不入库）
*.engine
*.onnx
*.pt

# Video / media
video/

# Type checker caches
.mypy_cache/
.pyre/
.pytype/

# Jupyter
.ipynb_checkpoints/

# OS files
Thumbs.db
Desktop.ini
.DS_Store
